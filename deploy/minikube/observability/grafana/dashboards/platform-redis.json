            "uid": "roboshop-prometheus"
          },
          "expr": "max(redis_memory_used_bytes{job=\"redis\"} and on(pod) (redis_instance_info{job=\"redis\",role=\"master\"})) / max(redis_memory_max_bytes{job=\"redis\"} and on(pod) (redis_instance_info{job=\"redis\",role=\"master\"}))",
          "legendFormat": "",
